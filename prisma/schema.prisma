generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum CaseStatus { OPEN PAUSED CLOSED }
enum EntityType { PERSON ACCOUNT USERNAME EMAIL PHONE ORGANIZATION DOMAIN LOCATION MEDIA FINANCIAL_ENTITY OTHER }
enum RelationshipStatus { CONFIRMED PROBABLE POSSIBLE CONFLICTING REJECTED }
model Case { id String @id @default(cuid()) title String description String? status CaseStatus @default(OPEN) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt entities Entity[] sources Source[] evidence Evidence[] events Event[] relations Relationship[] transactions Transaction[] }
model Entity { id String @id @default(cuid()) caseId String case Case @relation(fields:[caseId],references:[id],onDelete:Cascade) type EntityType label String canonical String? metadata Json? createdAt DateTime @default(now()) outgoing Relationship[] @relation("fromEntity") incoming Relationship[] @relation("toEntity") evidence EvidenceEntity[] }
model Relationship { id String @id @default(cuid()) caseId String case Case @relation(fields:[caseId],references:[id],onDelete:Cascade) fromEntityId String toEntityId String fromEntity Entity @relation("fromEntity",fields:[fromEntityId],references:[id],onDelete:Cascade) toEntity Entity @relation("toEntity",fields:[toEntityId],references:[id],onDelete:Cascade) type String confidence Float? status RelationshipStatus @default(POSSIBLE) firstSeenAt DateTime? lastSeenAt DateTime? createdAt DateTime @default(now()) }
model Source { id String @id @default(cuid()) caseId String case Case @relation(fields:[caseId],references:[id],onDelete:Cascade) url String title String? provider String? collectedAt DateTime @default(now()) metadata Json? evidence Evidence[] }
model Evidence { id String @id @default(cuid()) caseId String case Case @relation(fields:[caseId],references:[id],onDelete:Cascade) sourceId String? source Source? @relation(fields:[sourceId],references:[id],onDelete:SetNull) title String content String? sha256 String? observedAt DateTime? collectedAt DateTime @default(now()) metadata Json? entities EvidenceEntity[] }
model EvidenceEntity { evidenceId String entityId String evidence Evidence @relation(fields:[evidenceId],references:[id],onDelete:Cascade) entity Entity @relation(fields:[entityId],references:[id],onDelete:Cascade) @@id([evidenceId,entityId]) }
model Event { id String @id @default(cuid()) caseId String case Case @relation(fields:[caseId],references:[id],onDelete:Cascade) title String description String? occurredAt DateTime metadata Json? createdAt DateTime @default(now()) }
model Transaction { id String @id @default(cuid()) caseId String case Case @relation(fields:[caseId],references:[id],onDelete:Cascade) occurredAt DateTime amount Decimal @db.Decimal(14,2) currency String merchant String? counterparty String? category String? location String? synthetic Boolean @default(true) metadata Json? createdAt DateTime @default(now()) }
